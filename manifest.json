{
  "manifest_version": 3,
  "name": "Inspect Helper - Ultimate Anti-Debug & DevTools Unblocker",
  "version": "2.0.0",
  "description": "World-class shield: restores right-click, unblocks DevTools/F12, bypasses DisableDevtool, devtools-detector, worker loops, and proctoring tab-switch detection. Developed by SHIVAM ERP DEV.",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["anti-debug.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Inspect Helper Ultimate (Shields Active)",
    "default_icon": {
      "16": "logo.jpg",
      "48": "logo.jpg",
      "128": "logo.jpg"
    }
  },
  "icons": {
    "16": "logo.jpg",
    "48": "logo.jpg",
    "128": "logo.jpg"
  }
}

